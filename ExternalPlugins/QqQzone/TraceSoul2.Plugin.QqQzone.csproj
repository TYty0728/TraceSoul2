<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
    <AssemblyName>TraceSoul2.Plugin.QqQzone</AssemblyName>
    <RootNamespace>TraceSoul2.ExternalPlugins</RootNamespace>
    <Version>1.3.0</Version>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Tools\PluginApi\TraceSoul2.PluginApi.csproj"
                      Private="false" PrivateAssets="all" />
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="config_schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyToPluginFolder" AfterTargets="Build">
    <PropertyGroup>
      <QqQzonePluginFolder Condition="'$(TRACESOUL2_PLUGINS)' != ''">$(TRACESOUL2_PLUGINS)\qq-qzone\</QqQzonePluginFolder>
      <QqQzonePluginFolder Condition="'$(QqQzonePluginFolder)' == ''">D:\AISoftWare\TraceSoul2\plugins\qq-qzone\</QqQzonePluginFolder>
    </PropertyGroup>
    <MakeDir Directories="$(QqQzonePluginFolder)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(QqQzonePluginFolder)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)plugin.json;$(ProjectDir)config_schema.json"
          DestinationFolder="$(QqQzonePluginFolder)" SkipUnchangedFiles="true" />
  </Target>
</Project>
