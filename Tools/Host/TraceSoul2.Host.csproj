<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>TraceSoul2.Host</RootNamespace>
    <!-- 本地验证输出可能放在项目下；不能再被 SDK 当作下一次构建的 None/Content 输入递归收集。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**</DefaultItemExcludes>
  </PropertyGroup>
  <Import Project="../KernelSources.props" />
  <ItemGroup>
    <ProjectReference Include="../PluginApi/TraceSoul2.PluginApi.csproj" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.19.2" />
    <Content Include="../../resources/identity_cards.json" CopyToOutputDirectory="PreserveNewest" Link="identity_cards.json" />
    <Content Include="../../models/BgeSmallZh/bge-small-zh-v1.5.onnx" CopyToOutputDirectory="PreserveNewest" Link="Models/BgeSmallZh/bge-small-zh-v1.5.onnx" />
    <Content Include="../../models/BgeSmallZh/vocab.txt" CopyToOutputDirectory="PreserveNewest" Link="Models/BgeSmallZh/vocab.txt" />
    <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
